---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const frame = (slug: string, title: string, hgt: number) => `<iframe src="${SITE_URL}/embed/${slug}/" title="${title}" width="100%" height="${hgt}" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
const codes = [
  ['Jury duty pay calculator', frame('jury-duty-pay-calculator', 'Jury duty pay calculator by state', 860)],
  ['Can I be excused?', frame('can-i-be-excused', 'Can I be excused from jury duty?', 820)],
];
---
<PageLayout title="Embed the free jury duty pay calculator on your website" description="Put the jury duty pay calculator or the excuse checker on your site for employees or members: one iframe, no sign-up, no tracking, no cost, updated with each state's law." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a jury duty tool</h1>
    <p class="mt-3 text-lg text-navy-700">For HR intranets, unions, libraries and community sites.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {codes.map(([title, code]) => (<><h2>{title}</h2><pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre></>))}
    <p>Conditions: keep the credit line under the frame visible and use the tool as it is, without warranty. When a state changes its juror fee or its rules, the embedded tool updates with the site. Nothing your visitors type reaches us and the frame sets no cookie. Each frame states that the site is independent and not a court. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/jury-duty-pay-calculator/" title="Jury duty pay calculator by state" width="100%" height="860" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
